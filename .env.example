# ============================================
# AI Presentation Generator - Environment Config
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================

# Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Gemini model name - keep configurable, do not hard-code in source
GEMINI_MODEL=gemini-2.0-flash

# Embedding model used for RAG (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# SQLite database file
DATABASE_URL=sqlite:///./app.db

# Storage paths
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated_presentations
VECTOR_STORE_DIR=./vector_store

# Upload limits
MAX_UPLOAD_SIZE_MB=20

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
